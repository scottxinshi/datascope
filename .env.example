# datascope environment variables
# Copy this file to .env and fill in real values.

# --- Groq API ---------------------------------------------------------------
# Used by sql_agent, rag_agent, web_agent and orchestrator.
GROQ_API_KEY=your_groq_api_key_here

# Model ID. Leave unset to use the code default (openai/gpt-oss-120b).
#
# Groq retires models on a schedule - llama-3.3-70b-versatile was
# decommissioned on 2026-08-16 and every agent started returning
# 404 model_not_found. The model is read from this variable so the next
# deprecation is a one-line config change instead of a code edit.
#
# Current options: openai/gpt-oss-120b (flagship), openai/gpt-oss-20b (faster, cheaper)
# Full list: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# --- Tavily web search ------------------------------------------------------
# Used by web_agent. Free tier allows 1000 searches per month.
TAVILY_API_KEY=your_tavily_api_key_here
